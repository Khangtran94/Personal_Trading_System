# === Telegram (required for alerts) ===
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# === Binance (optional for public market data) ===
# Leave empty if you only need public klines / ticker data
BINANCE_API_KEY=
BINANCE_API_SECRET=

# === Runtime ===
# Asia/Ho_Chi_Minh (GMT+7)
ACTIVE_START=07:00
ACTIVE_END=23:00
COOLDOWN_MINUTES=30
# LONG when score in [SCORE_BUY_THRESHOLD, SCORE_BUY_MAX]
SCORE_BUY_THRESHOLD=11
SCORE_BUY_MAX=13
# SHORT when score in [SCORE_SELL_THRESHOLD, SCORE_SELL_MAX]
# sell_threshold = more negative bound (e.g. -13), sell_max closer to zero (e.g. -11)
SCORE_SELL_THRESHOLD=-13
SCORE_SELL_MAX=-11
ATR_SL_MULTIPLIER=1.5
RR_RATIO=2.0

# === Market regime filters ===
# Min ATR as % of price on 5m confirm TF (0 = disable)
MIN_ATR_PCT=0.5
# Min coins with same direction in one 3-min batch (1 = disable)
MIN_BATCH_SAME_DIRECTION=2

# === Ranking & selection (Top 1–2 per direction) ===
# Master switch (false = emit every coin that passed earlier filters)
ENABLE_RANKING=true
# Top-2 accepted only when ATR% >= Top1_ATR% * this ratio (0.75 ≈ within 25%)
RANK_CLOSENESS_RATIO=0.75
# Capital split when both Top1 + Top2 selected: 50_50 or 70_30
CAPITAL_SPLIT_MODE=70_30

# === Risk sizing (shown on each Telegram signal) ===
# Your account equity in USDT (update when balance changes)
ACCOUNT_EQUITY=1000
# Max loss per signal as % of equity (1.0 = 1%)
RISK_PER_TRADE_PCT=1.0
# Reference leverage for suggested margin
SUGGESTED_LEVERAGE=10

# SQLite path (relative to project root)
DATABASE_URL=sqlite:///./data/signals.db

# Logging
LOG_LEVEL=INFO
