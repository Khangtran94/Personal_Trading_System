# === Telegram (required for alerts) ===
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# === Binance (optional for public market data) ===
# Leave empty if you only need public klines / ticker data
BINANCE_API_KEY=
BINANCE_API_SECRET=

# === Runtime ===
# Asia/Ho_Chi_Minh (GMT+7)
ACTIVE_START=07:00
ACTIVE_END=23:00
COOLDOWN_MINUTES=30
SCORE_BUY_THRESHOLD=10
SCORE_SELL_THRESHOLD=-10
ATR_SL_MULTIPLIER=1.5
RR_RATIO=2.0

# SQLite path (relative to project root)
DATABASE_URL=sqlite:///./data/signals.db

# Logging
LOG_LEVEL=INFO
